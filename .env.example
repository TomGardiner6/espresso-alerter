# Copy to .env and fill in real values. NEVER commit .env (it is gitignored).
# If a real token is ever committed by accident, revoke and regenerate it —
# it persists in git history even after deletion.

# eBay Browse API (production keyset from https://developer.ebay.com/my/keys)
EBAY_CLIENT_ID=your-ebay-app-id-here
EBAY_CLIENT_SECRET=your-ebay-cert-id-here

# Telegram bot (create via @BotFather; chat ID via @userinfobot or getUpdates)
TELEGRAM_BOT_TOKEN=123456:your-bot-token-here
TELEGRAM_CHAT_ID=your-chat-id-here
